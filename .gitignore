# Ignore everything by default, then allow the repo content you want tracked.
/*

!.gitignore
!/README
!/README.*
!/AGENTS.md
!/CHANGELOG
!/CHANGELOG.*
!/LICENSE
!/LICENSE.*

!/01-corebook/
!/01-corebook/**
!/02-*/
!/02-*/**
!/03-*/
!/03-*/**
!/skills/
!/skills/**
!/docs/
!/reader/
!/reader/**

# Reader dependencies and generated build output.
/reader/node_modules/
/reader/dist/

# Explicitly keep these out even if a parent rule changes later.
/.codex
